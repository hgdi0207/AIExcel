# 服务基础配置
# 后端服务监听端口
PORT=3000
# 运行环境：development / production
NODE_ENV=development

# 数据库与缓存
# PostgreSQL 连接串
DATABASE_URL=postgresql://postgres:postgres@192.168.188.131:5431/aiexcel
# Redis 连接地址；当前可先预留，后续做缓存/队列时启用
REDIS_URL=redis://localhost:6379

# 鉴权配置
# JWT 签名密钥，生产环境必须替换
JWT_SECRET=change-me
# Access Token 有效期
ACCESS_TOKEN_TTL=15m
# Refresh Token 有效期
REFRESH_TOKEN_TTL=30d

# 前端跨域与回跳地址
# 允许跨域访问后端 API 的前端域名，多个可用逗号分隔
CORS_ORIGINS=http://localhost:3001
# OAuth 登录完成后，后端回跳的前端地址
FRONTEND_ORIGIN=http://127.0.0.1:3001

# 出站网络代理配置
# off=关闭代理，development=仅开发环境启用，on=始终启用
OUTBOUND_PROXY_MODE=development
# 本地代理地址，例如 Clash/代理软件监听的 HTTP 端口
OUTBOUND_PROXY_URL=http://127.0.0.1:7890
# 不走代理的地址白名单，多个用逗号分隔
OUTBOUND_NO_PROXY=127.0.0.1,localhost

# Stripe 支付配置
# Stripe 服务端 Secret Key
STRIPE_SECRET_KEY=
# Stripe Webhook 签名密钥
STRIPE_WEBHOOK_SECRET=

# AI Provider 配置
# AI 中转商或 OpenAI 兼容接口的 API Key
AI_PROVIDER_API_KEY=
# AI Provider 的基础地址；当前项目接 apimart.ai 的 OpenAI Responses 兼容接口
AI_PROVIDER_BASE_URL=https://api.apimart.ai/v1
# 是否允许把原始文件以 input_file 形式直接传给模型；MVP 默认关闭
AI_PROVIDER_ENABLE_INPUT_FILE=false
# 默认模型：常规任务
AI_MODEL_DEFAULT=gpt-5.6-terra
# 复杂分析模型：高质量、较高成本
AI_MODEL_COMPLEX=gpt-5.6-sol
# 高频低成本模型：轻量任务
AI_MODEL_FAST=gpt-5.6-luna

# Pivot 导出配置
# node_summary=Node 侧导出普通汇总 xlsx；java_native=调用 Java 服务导出原生 Excel PivotTable
PIVOT_EXPORT_MODE=node_summary
# Java Pivot 导出服务地址
PIVOT_EXPORT_SERVICE_URL=http://127.0.0.1:8085
# NestJS 与 Java 导出服务之间的共享鉴权 Token
PIVOT_EXPORT_SHARED_TOKEN=change-me
# 调用 Java 导出服务的超时时间，单位毫秒
PIVOT_EXPORT_TIMEOUT_MS=30000
# 可选：Pivot 导出文件根目录；为空时使用 backend/storage/exports/pivot
PIVOT_EXPORT_STORAGE_ROOT=

# Google OAuth 配置
# Google OAuth Client ID
GOOGLE_CLIENT_ID=
# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth 配置
# Microsoft OAuth Client ID
MICROSOFT_CLIENT_ID=
# Microsoft OAuth Client Secret
MICROSOFT_CLIENT_SECRET=

# 对象存储配置
# S3 / 兼容对象存储 Access Key
S3_ACCESS_KEY=
# S3 / 兼容对象存储 Secret Key
S3_SECRET_KEY=
# S3 / 兼容对象存储 Bucket 名称
S3_BUCKET=
