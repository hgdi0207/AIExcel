{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "node scripts/run-with-network-env.js nest start --watch",
    "build": "nest build",
    "start": "node scripts/run-with-network-env.js node dist/main",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ../prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.2",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "https-proxy-agent": "^7.0.6",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "prisma": "^6.14.0",
    "typescript": "^5.9.2"
  }
}
