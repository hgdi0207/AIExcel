# Java Pivot Export Service service port
PORT=8085

# Shared token used by NestJS to call this internal service
PIVOT_EXPORT_SHARED_TOKEN=change-me

# Output root directory. Keep this aligned with backend PIVOT_EXPORT_STORAGE_ROOT.
PIVOT_EXPORT_STORAGE_ROOT=../backend/storage/exports/pivot

# Allowed source file roots, comma-separated.
PIVOT_EXPORT_ALLOWED_SOURCE_ROOTS=../backend/storage/uploads,../backend/storage/local/uploads
