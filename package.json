{
  "name": "ai-excel",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "dev:pivot-java": "cd java-pivot-export-service && mvn spring-boot:run",
    "build:pivot-java": "cd java-pivot-export-service && mvn clean package"
  }
}
